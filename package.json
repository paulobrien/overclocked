{
  "name": "overclocked",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OVERCLOCKED — A live arcade-style race where three AI agents compete to clear a real enterprise backlog. Built for the Cerebras × Google DeepMind Gemma 4 hackathon.",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n web,worker -c green,cyan \"vite\" \"npm run dev:worker\"",
    "dev:worker": "wrangler dev worker/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run && playwright test",
    "datagen": "tsx scripts/generate.ts",
    "gen:assets": "tsx scripts/gen-assets.ts",
    "gen:docs": "tsx scripts/gen-docs.ts",
    "deploy:worker": "wrangler deploy",
    "deploy:pages": "wrangler pages deploy dist"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.2",
    "@ai-sdk/openai-compatible": "^3.0.1",
    "@rive-app/react-canvas": "^4.18.7",
    "ai": "^7.0.4",
    "canvas-confetti": "^1.9.3",
    "howler": "^2.2.4",
    "motion": "^11.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@docusaurus/core": "^3.10.1",
    "@docusaurus/module-type-aliases": "^3.10.1",
    "@docusaurus/preset-classic": "^3.10.1",
    "@eslint/js": "^9.39.4",
    "@mdx-js/react": "^3.1.1",
    "@playwright/test": "^1.61.1",
    "@types/canvas-confetti": "^1.6.4",
    "@types/howler": "^2.2.12",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
