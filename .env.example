# --- Client (Vite) — exposed to the browser. Never put secrets here. ---
# Where the agent Worker lives. Local dev defaults to wrangler dev on :8787
# (Vite proxies /api -> this base). For PRODUCTION builds, do NOT rely on this
# dev value — set VITE_AGENT_BASE in `.env.production` (see .env.production.example)
# to your deployed Worker URL, or use the public/_redirects.example proxy instead.
VITE_AGENT_BASE=http://localhost:8787

# --- Worker secrets — set via `wrangler secret put`, NOT here. ---
# Copy to .dev.vars for local `wrangler dev` only. .dev.vars is gitignored.
#
#   CEREBRAS_API_KEY      sk-...    (Cerebras, OpenAI-compatible)
#   CEREBRAS_BASE_URL     https://api.cerebras.ai/v1
#   OPENROUTER_API_KEY    sk-or-...
#   OPENROUTER_BASE_URL   https://openrouter.ai/api/v1
#   GEMINI_API_KEY        AIza...  (Google AI Studio key)
#   GEMINI_BASE_URL       (leave empty for the Google default endpoint)
#
# All three providers run through the Vercel AI SDK (streamObject + Zod):
#   CEREBRAS_MODEL        gemma-4-31b            (the headline wafer-scale lane)
#   OPENROUTER_MODEL      google/gemma-4-31b     (GPU-hosted equivalent)
#   GEMINI_MODEL          gemini-3.1-flash-lite  (the bottom production line)
